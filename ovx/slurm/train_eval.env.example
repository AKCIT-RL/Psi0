# Configuration for ovx/slurm/train_eval.sh. Copy it once and edit the copy:
#
#   cp ovx/slurm/train_eval.env.example ovx/slurm/train_eval.env
#
# ovx/slurm/train_eval*.env is gitignored, so editing it does not mark every run -dirty. Keep one
# copy per recurring experiment if useful (train_eval_lr.env, ...) and pass it as the argument.
# Plain bash: arrays for the optional extras, paths on the host.

# ---- cluster: the same for every run --------------------------------------------------------------
OVX_SIF=/raid/user_gustavobarros/images/ovx-gr00t_eval_<version>.sif   # the eval image also trains
OVX_DATA=/raid/user_gustavobarros/data          # datasets
OVX_CKPT=/raid/user_gustavobarros/checkpoints   # base models and training runs
OVX_CACHE=/raid/user_gustavobarros/cache        # HF, Isaac shaders, W&B
OVX_EVALS=/raid/user_gustavobarros/evals        # eval outputs
# OVX_SRC=/raid/user_gustavobarros/ws/Psi0_snapshot   # code to mount (default: this clone)

# ---- training ---------------------------------------------------------------------------------------
DATASET=carry_totes                             # directory under OVX_DATA
BASE_MODEL=<model dir under OVX_CKPT>
RUN_NAME=                                       # empty: <dataset>_<date-time>. An existing name RESUMES that run
TRAIN_ARGS=(--epochs 30)                        # any `ovx/run.sh train --help` option: --max-steps,
                                                # --batch-size, --config exp.yaml, --no-wandb, ...

# ---- eval of the trained model -------------------------------------------------------------------
ENV_ID=simple/G1IndustrialSortingTeleop-v0      # subtask datasets: success reads 0 (whole-task criterion)
EVAL_DATA=                                      # starting episodes; empty: the training DATASET
EVAL_ARGS=(--num-episodes 20)                   # any `ovx/run.sh eval --help` option: --sim-mode,
                                                # --max-episode-steps, --no-video, ...

# ---- SLURM: one job for both stages (defaults: 1 GPU, 32 CPUs, 128 GB, 54 h) --------------------
SBATCH_ARGS=()                                  # e.g. (--time=80:00:00) for a long training
